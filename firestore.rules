rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function bookingDoc(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    // Phase 3: true if the signed-in user's profile has role "admin".
    // get() reads users/{uid}: one extra document read per request that
    // reaches this check. Roles can only be set in the Firebase console.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Phase 3: the only shape a service document may have.
    // Same limits as admin_web/lib/validation.ts.
    function validService(data) {
      return data.keys().hasOnly(['name', 'description', 'durationMinutes', 'price', 'active'])
        && data.keys().hasAll(['name', 'description', 'durationMinutes', 'price', 'active'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 300
        // Any whole number: services typed into the console may be stored as 30.0.
        && data.durationMinutes is number && data.durationMinutes == math.floor(data.durationMinutes)
        && data.durationMinutes >= 1 && data.durationMinutes <= 480
        && data.price is number && data.price >= 0
        && data.active is bool;
    }

    // Must build the same ID as SlotCalculator.slotId() in the app.
    function slotDoc(serviceId, startAt) {
      return /databases/$(database)/documents/slots/$(serviceId + '_' + string(startAt.toMillis()));
    }

    // ---------- users/{uid} ----------

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin(); // Phase 3: customer names and emails.
      // PROPOSED (Phase 4): exactly the fields the app writes, a sane name,
      // and the email of the signed-in account (Auth stores it lowercase).
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
                    && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.email is string
                    && request.resource.data.email.lower() == request.auth.token.email
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.role == 'customer';
      allow update, delete: if false;
    }

    // ---------- services/{serviceId} ----------

    match /services/{serviceId} {
      allow read: if signedIn();
      // Phase 3: admins add and edit services. Nobody deletes them (old
      // bookings refer to them); deactivate instead.
      allow create, update: if isAdmin() && validService(request.resource.data);
      allow delete: if false;
    }

    // ---------- bookings/{bookingId} ----------

    match /bookings/{bookingId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin(); // Phase 3: all bookings.

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'serviceId', 'serviceName', 'startAt', 'durationMinutes', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'serviceId', 'serviceName', 'startAt', 'durationMinutes', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.createdAt == request.time
        && request.resource.data.startAt > request.time
        // PROPOSED (Phase 4): the app offers 14 days; allow a day of slack
        // for time zones. Starts must be on the app's 30-minute grid.
        && request.resource.data.startAt < request.time + duration.value(15, 'd')
        && request.resource.data.startAt.toMillis() % (30 * 60 * 1000) == 0
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.active == true
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.name == request.resource.data.serviceName
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.durationMinutes == request.resource.data.durationMinutes
        && getAfter(slotDoc(request.resource.data.serviceId, request.resource.data.startAt)).data.bookingId == bookingId;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.startAt > request.time
        && !existsAfter(slotDoc(resource.data.serviceId, resource.data.startAt));

      // Phase 3: an admin cancels any customer's booking. The same checks as
      // above, without "it's your own booking".
      allow update: if isAdmin()
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.startAt > request.time
        && !existsAfter(slotDoc(resource.data.serviceId, resource.data.startAt));

      allow delete: if false;
    }

    // ---------- slots/{slotId} ----------
    // One document per taken time. No personal data.

    match /slots/{slotId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['serviceId', 'startAt', 'bookingId'])
        && request.resource.data.keys().hasAll(['serviceId', 'startAt', 'bookingId'])
        && slotId == request.resource.data.serviceId + '_' + string(request.resource.data.startAt.toMillis())
        && getAfter(bookingDoc(request.resource.data.bookingId)).data.userId == request.auth.uid
        && getAfter(bookingDoc(request.resource.data.bookingId)).data.status == 'confirmed'
        && getAfter(bookingDoc(request.resource.data.bookingId)).data.serviceId == request.resource.data.serviceId
        && getAfter(bookingDoc(request.resource.data.bookingId)).data.startAt == request.resource.data.startAt;

      allow update: if false;

      allow delete: if signedIn()
        && get(bookingDoc(resource.data.bookingId)).data.userId == request.auth.uid
        && getAfter(bookingDoc(resource.data.bookingId)).data.status == 'cancelled';

      // Phase 3: an admin frees the slot of a booking they cancel.
      allow delete: if isAdmin()
        && getAfter(bookingDoc(resource.data.bookingId)).data.status == 'cancelled';
    }

    // Everything else is denied by default.
  }
}
