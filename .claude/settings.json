{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter devices:*)",
      "Bash(adb devices:*)",
      "Bash(adb exec-out screencap:*)",
      "Bash(adb shell screencap:*)",
      "Bash(adb pull:*)",
      "Bash(scrcpy:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch -c:*)",
      "Bash(git checkout -b:*)",
      "PowerShell(flutter analyze:*)",
      "PowerShell(flutter test:*)",
      "PowerShell(flutter pub get:*)",
      "PowerShell(flutter devices:*)",
      "PowerShell(adb devices:*)",
      "PowerShell(adb exec-out screencap:*)",
      "PowerShell(adb shell screencap:*)",
      "PowerShell(adb pull:*)",
      "PowerShell(scrcpy:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git switch -c:*)",
      "PowerShell(git checkout -b:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(firebase:*)",
      "Bash(flutter build:*)",
      "PowerShell(git push:*)",
      "PowerShell(firebase:*)",
      "PowerShell(flutter build:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/key.properties)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(firebase deploy:*)",
      "Bash(firebase * deploy:*)",
      "Bash(npx firebase deploy:*)",
      "Bash(npx firebase-tools deploy:*)",
      "Bash(firebase firestore:delete:*)",
      "Bash(firebase auth:import:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(firebase deploy:*)",
      "PowerShell(firebase * deploy:*)",
      "PowerShell(npx firebase deploy:*)",
      "PowerShell(npx firebase-tools deploy:*)",
      "PowerShell(firebase firestore:delete:*)",
      "PowerShell(firebase auth:import:*)"
    ]
  }
}
