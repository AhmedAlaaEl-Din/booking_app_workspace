# Copy this file to .env.local and fill in the values from the Firebase console:
# Project settings -> General -> Your apps -> (your Web app) -> SDK setup and configuration -> Config.
# These identify your Firebase project; they are not secret (see README).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
